{
  "name": "design-j6n",
  "version": "0.3.0",
  "description": "Design system personnel — Foulée. theme.css + theme.js, sans dépendance ni build.",
  "main": "theme.js",
  "style": "theme.css",
  "types": "theme.d.ts",
  "bin": {
    "design-j6n": "bin/design-j6n.mjs"
  },
  "unpkg": "theme.min.js",
  "jsdelivr": "theme.min.js",
  "exports": {
    ".": {
      "types": "./theme.d.ts",
      "default": "./theme.js"
    },
    "./theme.js": "./theme.js",
    "./theme.min.js": "./theme.min.js",
    "./theme.css": "./theme.css",
    "./theme.min.css": "./theme.min.css",
    "./fonts.css": "./fonts.css",
    "./fonts/*": "./fonts/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css",
    "./theme.js",
    "./theme.min.js"
  ],
  "files": [
    "theme.css",
    "theme.js",
    "theme.min.css",
    "theme.min.js",
    "theme.d.ts",
    "fonts.css",
    "fonts/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "J. Dudek",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/J-Dudek/design-j6n.git"
  },
  "homepage": "https://github.com/J-Dudek/design-j6n#readme",
  "keywords": [
    "design-system",
    "css",
    "theme",
    "oklch"
  ],
  "engines": {
    "node": ">=18"
  }
}
